# Copy to .env for local-only values. Never commit .env.
LLM_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
TESTFLIGHT_DSH_PROFILE=headless
TESTFLIGHT_DSH_MODEL=
TESTFLIGHT_DSH_BASE_URL=
TESTFLIGHT_DSH_HOME=.data/deepseek-harness
TESTFLIGHT_REPOSITORY_ROOT=
TESTFLIGHT_CONTEXT_CONFIG=workspaces/brand-nike-research/INTELLIGENCE.json
TESTFLIGHT_CONTEXT_PYTHON=.venv-cognee/bin/python
# Recommended for grounded, structured context compilation; separate from TESTFLIGHT_DSH_MODEL.
TESTFLIGHT_INTELLIGENCE_MODEL=openai/gpt-5.4-mini
TESTFLIGHT_INTELLIGENCE_BASE_URL=https://openrouter.ai/api/v1
TESTFLIGHT_INTELLIGENCE_API_KEY_ENV=OPENROUTER_API_KEY
TESTFLIGHT_SERVER=home-server
TESTFLIGHT_REMOTE_DIR=/home/talha/testflight
# Local Creative Field operator runtime. Set the API key in the named environment variable only.
TESTFLIGHT_OPERATOR_BASE_URL=
TESTFLIGHT_OPERATOR_MODEL_ID=gpt-5.6-luna
TESTFLIGHT_OPERATOR_PROVIDER_ID=configured-compatible
TESTFLIGHT_OPERATOR_API_KEY_ENV=LLM_API_KEY
TESTFLIGHT_OPERATOR_HOST=127.0.0.1
TESTFLIGHT_OPERATOR_PORT=8781
TESTFLIGHT_OPERATOR_TIMEOUT_MS=120000
TESTFLIGHT_OPERATOR_MAX_ATTEMPTS=2
# Creative Studio points at the private local runtime transport; leave empty to disable analysis.
TESTFLIGHT_OPERATOR_ENDPOINT=http://127.0.0.1:8781/execute
TESTFLIGHT_OPERATOR_WORKSPACE_ID=world://workspace/creative-studio
TESTFLIGHT_CREATIVE_OPERATOR_INDEX=reasoning/operators/index.yaml
TESTFLIGHT_CREATIVE_OPERATOR_PACK=
TESTFLIGHT_CREATIVE_WORLD_MODEL=
TESTFLIGHT_CREATIVE_DIMENSIONS=domains/creative-field/dimensions.yaml
TESTFLIGHT_CREATIVE_PROJECT_PURPOSE=Explore a project-scoped creative direction.
TESTFLIGHT_CREATIVE_AUTHORITY_GRANT_ID=
